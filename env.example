ORACLE_IMAGE=container-registry.oracle.com/database/enterprise:19.3.0.0
ORACLE_SID=ORCLCDB
ORACLE_PDB=ORCLPDB1
ORACLE_PASSWORD=SET_A_LOCAL_PASSWORD
ORACLE_PORT=1521
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=SET_A_LOCAL_PASSWORD
KEYCLOAK_PORT=8081
DB_URL=jdbc:oracle:thin:@localhost:1521/ORCLPDB1
DB_USERNAME=audit_app
DB_PASSWORD=SET_A_LOCAL_PASSWORD
OIDC_ISSUER_URI=http://localhost:8081/realms/audit-demo
OIDC_CLIENT_ID=audit-example
OIDC_REDIRECT_URI=http://localhost:8080/login/oauth2/code/demo-oidc
AUDIT_APPLICATION=audit-oracle-example
AUDIT_USER_CLAIM=sub
# Set TRUSTED_PROXY_REGEX to the addresses of trusted ingress/reverse proxies in your environment.
