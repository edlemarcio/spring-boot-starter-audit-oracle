# Oracle 19c image: requires Oracle Container Registry access and license acceptance.
ORACLE_IMAGE=container-registry.oracle.com/database/enterprise:19.3.0.0
ORACLE_SID=ORCLCDB
ORACLE_PDB=ORCLPDB1
ORACLE_PASSWORD=LocalOracle19c!
ORACLE_PORT=1521

# Local Keycloak only. Change these values on shared environments.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8081

# Spring Boot example application (run on host)
DB_URL=jdbc:oracle:thin:@localhost:1521/ORCLPDB1
DB_USERNAME=audit_app
DB_PASSWORD=change-me
OIDC_ISSUER_URI=http://localhost:8081/realms/audit-demo
OIDC_CLIENT_ID=audit-example
OIDC_CLIENT_SECRET=audit-example-dev-secret
OIDC_REDIRECT_URI=http://localhost:8080/login/oauth2/code/keycloak
