<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.edlemarcio</groupId>
    <artifactId>spring-boot-starter-audit-oracle</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Spring Boot Starter Audit Oracle</name>
    <description>Connection-based Oracle session auditing for Spring applications.</description>
    <url>https://github.com/edlemarcio/spring-boot-starter-audit-oracle</url>

    <modules>
        <module>audit-oracle-core</module>
        <module>audit-oracle-spring-boot-autoconfigure</module>
        <module>audit-oracle-spring-boot-starter</module>
        <module>audit-oracle-example</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.5.16</spring-boot.version>
        <oracle-jdbc.version>23.9.0.25.07</oracle-jdbc.version>
        <maven.compiler.plugin.version>3.14.1</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.4</maven.surefire.plugin.version>
        <audit.excludedGroups>oracle-concurrency | oracle-stress</audit.excludedGroups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.oracle.database.jdbc</groupId>
                <artifactId>ojdbc11</artifactId>
                <version>${oracle-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                    <configuration>
                        <excludedGroups>${audit.excludedGroups}</excludedGroups>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>oracle-concurrency</id>
            <properties>
                <audit.excludedGroups>oracle-stress</audit.excludedGroups>
            </properties>
        </profile>
        <profile>
            <id>oracle-stress</id>
            <properties>
                <audit.excludedGroups></audit.excludedGroups>
            </properties>
        </profile>
    </profiles>

    <scm>
        <connection>scm:git:git://github.com/edlemarcio/spring-boot-starter-audit-oracle.git</connection>
        <developerConnection>scm:git:ssh://github.com/edlemarcio/spring-boot-starter-audit-oracle.git</developerConnection>
        <url>https://github.com/edlemarcio/spring-boot-starter-audit-oracle</url>
    </scm>
</project>
